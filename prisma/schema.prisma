generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  TRIAL
  SUSPENDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model SuperAdmin {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@map("super_admins")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String // "SUPER_ADMIN" أو "CENTER_ADMIN"
  centerId  String?  @map("center_id")
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username])
  @@map("users")
}

model Center {
  id                  String             @id @default(uuid())
  centerId            String?            @unique @default(uuid())
  name                String
  code                String?            @unique @default(uuid())
  plan                String             @default("ACTIVE")
  isActive            Boolean            @default(true)
  expiresAt           DateTime?
  email               String?            @unique
  phone               String?
  password_hash       String?
  subscription_status SubscriptionStatus @default(TRIAL)
  expires_at          DateTime?
  whatsapp_template   String?            @db.Text

  allowedStudentCodes Int    @default(0)
  usedStudentCodes    Int    @default(0)
  managerPasswordHash String @default("$2a$10$e9Q2z6.R8fN6Z9v9K9e9eO")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  teachers           Teacher[]
  students           Student[]
  groups             Group[]
  serviceSales       ServiceSale[]
  systemLogsMessages SystemLogMessage[]

  halls           Hall[]
  booklets        Booklet[]
  inventoryTxns   InventoryTransaction[]
  studentPayments    StudentFeePayment[]
  monthlyClosings    MonthlyClosing[]
  expenses           Expense[]
  teacherPayouts     TeacherPayout[]
  studentEnrollments StudentEnrollment[]
  attendances        Attendance[]
  evaluations        Evaluation[]
  grades             Grade[]

  @@index([email])
  @@map("centers")
}

model Teacher {
  id               String         @id @default(uuid())
  center_id        String         @map("center_id")
  name             String
  subject          String
  phone            String
  stage            String?        @map("stage")
  grades           Json?          @map("grades")
  commission_type  CommissionType @default(PERCENTAGE) @map("commission_type")
  commission_value Decimal        @default(0.00) @map("commission_value") @db.Decimal(10, 2)
  centerPercentage Float          @default(30.0) @map("center_percentage")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  center      Center           @relation(fields: [center_id], references: [id], onDelete: Cascade)
  services    TeacherService[]
  groups      Group[]
  payouts     TeacherPayout[]
  enrollments StudentEnrollment[]

  @@index([center_id])
  @@map("teachers")
}

model TeacherService {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  teacherId String   @map("teacher_id")
  type      String // "MONTHLY_FEE", "TERM_RESERVATION", "NIGHT_REVIEW", "BOOKLET_ONLY"
  title     String
  price     Float
  dates     String?
  hallId    String?
  bookletId String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sales   ServiceSale[]

  @@index([teacherId])
  @@index([centerId])
  @@map("teacher_services")
}

model Student {
  id                  String   @id @default(uuid())
  centerId            String   @map("center_id")
  groupId             String?
  code                String   @map("student_code")
  barcode             String   @default("")
  name                String
  grade               String   @default("")
  student_phone       String?  @map("student_phone")
  parent_phone        String   @map("parent_phone")
  alert_status        Boolean  @default(false) @map("alert_status")
  alert_note          String?  @map("alert_note") @db.Text
  isBlocked           Boolean  @default(false)
  hasFinancialWarning Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  center      Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  grades      Grade[]
  sales       ServiceSale[]
  enrollments StudentEnrollment[]
  group       Group?        @relation(fields: [groupId], references: [id])

  @@unique([centerId, code])
  @@index([centerId])
  @@index([code])
  @@map("students")
}

model Group {
  id            String   @id @default(uuid())
  centerId      String   @map("center_id")
  teacherId     String   @map("teacher_id")
  hallId        String?
  name          String
  dayOfWeek     String   @default("")
  startTime     String   @default("")
  endTime       String   @default("")
  grade         String   @default("")
  price         Float
  schedule_days Json?    @map("schedule_days") // Kept for backward compatibility if needed, but not required
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  center      Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  hall        Hall?        @relation(fields: [hallId], references: [id])
  attendances Attendance[]
  evaluations Evaluation[]
  students    Student[]
  enrollments StudentEnrollment[]

  @@index([centerId])
  @@index([teacherId])
  @@map("groups")
}

model Attendance {
  id         String           @id @default(uuid())
  centerId   String?          @map("center_id")
  student_id String           @map("student_id")
  group_id   String           @map("group_id")
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  center  Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([student_id, group_id, date])
  @@index([centerId])
  @@index([student_id])
  @@index([group_id])
  @@map("attendance")
}

model Evaluation {
  id        String   @id @default(uuid())
  centerId  String?  @map("center_id")
  group_id  String   @map("group_id")
  type      String
  title     String
  max_score Float    @map("max_score")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center Center? @relation(fields: [centerId], references: [id], onDelete: Cascade)
  group  Group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  grades Grade[]

  @@index([centerId])
  @@index([group_id])
  @@map("evaluations")
}

model Grade {
  id            String   @id @default(uuid())
  centerId      String?  @map("center_id")
  evaluation_id String   @map("evaluation_id")
  student_id    String   @map("student_id")
  score         Float
  is_submitted  Boolean  @default(true) @map("is_submitted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  center     Center?    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluation_id], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([evaluation_id, student_id])
  @@index([centerId])
  @@index([evaluation_id])
  @@index([student_id])
  @@map("grades")
}

model ServiceSale {
  id          String   @id @default(uuid())
  center_id   String   @map("center_id")
  student_id  String   @map("student_id")
  service_id  String   @map("service_id")
  amount_paid Decimal  @map("amount_paid") @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  center  Center         @relation(fields: [center_id], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  service TeacherService @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([center_id])
  @@index([student_id])
  @@index([service_id])
  @@map("service_sales")
}

model SystemLogMessage {
  id            String   @id @default(uuid())
  center_id     String   @map("center_id")
  message_count Int      @default(1) @map("message_count")
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  center Center @relation(fields: [center_id], references: [id], onDelete: Cascade)

  @@index([center_id])
  @@map("system_logs_messages")
}

model Hall {
  id        String   @id @default(uuid())
  centerId  String
  name      String
  capacity  Int
  createdAt DateTime @default(now())

  center Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([centerId])
}

model Booklet {
  id        String   @id @default(uuid())
  centerId  String
  teacherId String
  title     String
  price     Float
  quantity  Int      @default(0)
  createdAt DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([teacherId])
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  centerId        String
  type            String // "SALE", "ADD", "RETURN", "ADJUSTMENT"
  bookletId       String
  studentId       String?
  studentName     String?
  quantityChanged Int
  totalPrice      Float
  createdAt       DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([bookletId])
}

model StudentFeePayment {
  id            String   @id @default(uuid())
  centerId      String
  studentId     String
  groupId       String
  serviceId     String?
  bookletId     String?
  amount        Float
  paymentType   String // "MONTHLY", "ADVANCE_MONTH", "TERM_RESERVATION", "NIGHT_REVIEW", "BOOKLET_ONLY"
  monthYear     String
  secretaryName String
  createdAt     DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([studentId])
}

model MonthlyClosing {
  id                String   @id @default(uuid())
  centerId          String
  monthYear         String
  totalRevenue      Float
  totalBookletSales Float
  closedByManager   String
  createdAt         DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
}

model Expense {
  id        String   @id @default(uuid())
  centerId  String
  title     String
  category  String   // "Electricity", "Water", "Rent", "Maintenance", "Other"
  amount    Float
  createdAt DateTime @default(now())

  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
}

model TeacherPayout {
  id        String   @id @default(uuid())
  centerId  String
  teacherId String
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([teacherId])
}

model StudentEnrollment {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  studentId String   @map("student_id")
  groupId   String   @map("group_id")
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  center  Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId])
  @@index([centerId])
  @@index([studentId])
  @@index([groupId])
  @@map("student_enrollments")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  TRIAL
  SUSPENDED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PrepaidCardStatus {
  UNUSED
  USED
}

model SuperAdmin {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  @@map("super_admins")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String // "SUPER_ADMIN" أو "CENTER_ADMIN"
  centerId  String?  @map("center_id")
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username])
  @@map("users")
}

model Center {
  id                  String             @id @default(uuid())
  centerId            String?            @unique @default(uuid())
  name                String
  code                String?            @unique @default(uuid())
  plan                String             @default("ACTIVE")
  isActive            Boolean            @default(true)
  expiresAt           DateTime?
  email               String?            @unique
  phone               String?
  password_hash       String?
  subscription_status SubscriptionStatus @default(TRIAL)
  expires_at          DateTime?
  whatsapp_template   String?            @db.Text

  allowedStudentCodes Int    @default(0)
  usedStudentCodes    Int    @default(0)
  managerPasswordHash String @default("$2a$10$e9Q2z6.R8fN6Z9v9K9e9eO")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  teachers           Teacher[]
  students           Student[]
  groups             Group[]
  serviceSales       ServiceSale[]
  systemLogsMessages SystemLogMessage[]

  halls           Hall[]
  booklets        Booklet[]
  inventoryTxns   InventoryTransaction[]
  studentPayments StudentFeePayment[]
  monthlyClosings MonthlyClosing[]
  expenses        Expense[]
  teacherPayouts  TeacherPayout[]
  studentEnrollments StudentEnrollment[]
  attendances     Attendance[]
  evaluations     Evaluation[]
  grades          Grade[]
  
  // New Models relationships
  prepaidCards    CenterPrepaidCard[]
  assessments     Assessment[]
  studentGrades   StudentGrade[]
  shiftClosings   ShiftClosing[]
  whatsappSettings WhatsAppSetting[]

  @@index([email])
  @@map("centers")
}

model WhatsAppSetting {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  apiKey    String?
  clientId  String?
  templates Json?    // To store { "attendance": "...", "exam": "...", "receipt": "..." }
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@map("whatsapp_settings")
}

model CenterPrepaidCard {
  id        String            @id @default(uuid())
  centerId  String            @map("center_id")
  code      String            @unique
  prefix    String
  status    PrepaidCardStatus @default(UNUSED)
  studentId String?           @map("student_id") // Links to student if USED
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  center  Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([centerId])
  @@index([code])
  @@map("center_prepaid_cards")
}

model Teacher {
  id               String         @id @default(uuid())
  centerId         String         @map("center_id")
  name             String
  subject          String
  phone            String
  stage            String?        @map("stage")
  grades           Json?          @map("grades")
  commission_type  CommissionType @default(PERCENTAGE) @map("commission_type")
  commission_value Decimal        @default(0.00) @map("commission_value") @db.Decimal(10, 2)
  centerPercentage Float          @default(30.0) @map("center_percentage")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  center      Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  services    TeacherService[]
  groups      Group[]
  payouts     TeacherPayout[]
  enrollments StudentEnrollment[]

  @@index([centerId])
  @@map("teachers")
}

model TeacherService {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  teacherId String   @map("teacher_id")
  type      String // "MONTHLY_FEE", "TERM_RESERVATION", "NIGHT_REVIEW", "BOOKLET_ONLY"
  title     String
  price     Float
  dates     String?
  hallId    String?  @map("hall_id")
  bookletId String?  @map("booklet_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher     Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sales       ServiceSale[]
  feePayments StudentFeePayment[]

  @@index([teacherId])
  @@index([centerId])
  @@map("teacher_services")
}

model Student {
  id                  String   @id @default(uuid())
  centerId            String   @map("center_id")
  groupId             String?  @map("group_id")
  code                String   @map("student_code")
  barcode             String   @default("")
  name                String
  grade               String   @default("")
  student_phone       String?  @map("student_phone")
  parent_phone        String   @map("parent_phone")
  alert_status        Boolean  @default(false) @map("alert_status")
  alert_note          String?  @map("alert_note") @db.Text
  isBlocked           Boolean  @default(false)
  hasFinancialWarning Boolean  @default(false)
  remainingSessions   Int      @default(0) @map("remaining_sessions")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  center      Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  grades      Grade[]
  sales       ServiceSale[]
  enrollments StudentEnrollment[]
  group       Group?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  feePayments StudentFeePayment[]
  
  prepaidCards  CenterPrepaidCard[]
  studentGrades StudentGrade[]

  @@unique([centerId, code])
  @@index([centerId])
  @@index([code])
  @@map("students")
}

model Group {
  id               String   @id @default(uuid())
  centerId         String   @map("center_id")
  teacherId        String   @map("teacher_id")
  hallId           String?  @map("hall_id")
  name             String
  dayOfWeek        String   @default("")
  startTime        String   @default("")
  endTime          String   @default("")
  grade            String   @default("")
  price            Float
  sessionsPerMonth Int      @default(4) @map("sessions_per_month")
  schedule_days    Json?    @map("schedule_days") // Kept for backward compatibility if needed, but not required
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  center      Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher     Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  hall        Hall?               @relation(fields: [hallId], references: [id], onDelete: SetNull)
  attendances Attendance[]
  evaluations Evaluation[]
  students    Student[]
  enrollments StudentEnrollment[]
  feePayments StudentFeePayment[]
  
  assessments Assessment[]

  @@index([centerId])
  @@index([teacherId])
  @@map("groups")
}

model Attendance {
  id         String           @id @default(uuid())
  centerId   String?          @map("center_id")
  student_id String           @map("student_id")
  group_id   String           @map("group_id")
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  center  Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([student_id, group_id, date])
  @@index([centerId])
  @@index([student_id])
  @@index([group_id])
  @@map("attendance")
}

// Legacy Evaluation model
model Evaluation {
  id        String   @id @default(uuid())
  centerId  String?  @map("center_id")
  group_id  String   @map("group_id")
  type      String
  title     String
  max_score Float    @map("max_score")
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center Center? @relation(fields: [centerId], references: [id], onDelete: Cascade)
  group  Group   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  grades Grade[]

  @@index([centerId])
  @@index([group_id])
  @@map("evaluations")
}

// Legacy Grade model
model Grade {
  id            String   @id @default(uuid())
  centerId      String?  @map("center_id")
  evaluation_id String   @map("evaluation_id")
  student_id    String   @map("student_id")
  score         Float
  is_submitted  Boolean  @default(true) @map("is_submitted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  center     Center?    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluation_id], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([evaluation_id, student_id])
  @@index([centerId])
  @@index([evaluation_id])
  @@index([student_id])
  @@map("grades")
}

// New Assessment model
model Assessment {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  groupId   String   @map("group_id")
  title     String
  maxScore  Float    @map("max_score")
  date      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  
  studentGrades StudentGrade[]

  @@index([centerId])
  @@index([groupId])
  @@map("assessments")
}

// New StudentGrade model
model StudentGrade {
  id           String   @id @default(uuid())
  centerId     String   @map("center_id")
  assessmentId String   @map("assessment_id")
  studentId    String   @map("student_id")
  score        Float
  isAbsent     Boolean  @default(false) @map("is_absent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  center     Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([centerId])
  @@index([assessmentId])
  @@index([studentId])
  @@map("student_grades")
}


model ServiceSale {
  id          String   @id @default(uuid())
  centerId    String   @map("center_id")
  student_id  String   @map("student_id")
  service_id  String   @map("service_id")
  amount_paid Decimal  @map("amount_paid") @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  center  Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  service TeacherService @relation(fields: [service_id], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([student_id])
  @@index([service_id])
  @@map("service_sales")
}

model SystemLogMessage {
  id            String   @id @default(uuid())
  centerId      String   @map("center_id")
  message_count Int      @default(1) @map("message_count")
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@map("system_logs_messages")
}

model Hall {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  name      String
  capacity  Int
  createdAt DateTime @default(now())

  center Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  groups Group[]

  @@index([centerId])
  @@map("halls")
}

model Booklet {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  teacherId String   @map("teacher_id")
  title     String
  price     Float
  quantity  Int      @default(0)
  createdAt DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([teacherId])
  @@map("booklets")
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  centerId        String   @map("center_id")
  type            String // "SALE", "ADD", "RETURN", "ADJUSTMENT"
  bookletId       String   @map("booklet_id")
  studentId       String?  @map("student_id")
  studentName     String?  @map("student_name")
  quantityChanged Int
  totalPrice      Float
  createdAt       DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([bookletId])
  @@map("inventory_transactions")
}

model StudentFeePayment {
  id            String   @id @default(uuid())
  centerId      String   @map("center_id")
  studentId     String?  @map("student_id")
  groupId       String?  @map("group_id")
  serviceId     String?  @map("service_id")
  bookletId     String?  @map("booklet_id")
  amount        Float
  paymentType   String // "MONTHLY", "ADVANCE_MONTH", "TERM_RESERVATION", "NIGHT_REVIEW", "BOOKLET_ONLY"
  monthYear     String
  secretaryName String
  createdAt     DateTime @default(now())

  center  Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  group   Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  service TeacherService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([centerId])
  @@index([studentId])
  @@map("student_fee_payments")
}

model MonthlyClosing {
  id                String   @id @default(uuid())
  centerId          String   @map("center_id")
  monthYear         String
  totalRevenue      Float
  totalBookletSales Float
  closedByManager   String
  createdAt         DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@map("monthly_closings")
}

model ShiftClosing {
  id                String   @id @default(uuid())
  centerId          String   @map("center_id")
  date              DateTime @default(now()) @db.Date
  openingCash       Float    @map("opening_cash")
  incomingPayments  Float    @map("incoming_payments")
  operationalExpenses Float  @map("operational_expenses")
  netExpectedCash   Float    @map("net_expected_cash")
  actualDrawerCash  Float    @map("actual_drawer_cash")
  discrepancy       Float    @default(0) // Over or Short
  closedBy          String   @map("closed_by")
  createdAt         DateTime @default(now()) @map("created_at")

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@map("shift_closings")
}

model Expense {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  title     String
  category  String   // "Electricity", "Water", "Rent", "Maintenance", "Other"
  amount    Float
  createdAt DateTime @default(now())

  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@map("expenses")
}

model TeacherPayout {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  teacherId String   @map("teacher_id")
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@index([teacherId])
  @@map("teacher_payouts")
}

model StudentEnrollment {
  id        String   @id @default(uuid())
  centerId  String   @map("center_id")
  studentId String   @map("student_id")
  groupId   String   @map("group_id")
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  center  Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId])
  @@index([centerId])
  @@index([studentId])
  @@index([groupId])
  @@map("student_enrollments")
}

{
  "name": "center-system-saas",
  "version": "1.0.0",
  "description": "Multi-tenant SaaS Backend for Educational Center Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "prisma db push --accept-data-loss && node src/server.js",
    "dev": "nodemon src/server.js",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "prisma",
    "postgresql",
    "saas",
    "education-center"
  ],
  "author": "Senior System Architect",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  }
}